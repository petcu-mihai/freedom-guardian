<?xml version="1.0" encoding="utf-8"?>
<!--
  Classic (non-SDK) project for contributors who have Visual Studio or the
  .NET Framework 4.8 Developer Pack installed. On a machine without a targeting
  pack, use ..\build.ps1 instead (compiles directly with csc.exe).
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>FreedomGuardian</RootNamespace>
    <AssemblyName>FreedomGuardian</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <OutputPath>..\build\</OutputPath>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\assets\FreedomGuardian.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="Config.cs" />
    <Compile Include="Log.cs" />
    <Compile Include="UnlockStore.cs" />
    <Compile Include="SessionLauncher.cs" />
    <Compile Include="ServiceControl.cs" />
    <Compile Include="RunKeyHealer.cs" />
    <Compile Include="Workers.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
